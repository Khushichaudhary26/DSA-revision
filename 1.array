1. Compare every element with every other element

#include <iostream>
using namespace std;
int main() {
    int n;
    cin>>n;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            if(i!=j){
                cout<<"{"<<arr[i]<<","<<arr[j]<<"}";
            }
            cout<<endl;
        }
    }
    return 0;
}

3. Find duplicate elements using two loops
#include <iostream>
using namespace std;
int main() {
    int n;
    cin>>n;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    for(int i=0;i<n;i++){
        for(int j=i+1;j<n;j++){
            if(arr[i]==arr[j]){
                cout<<arr[i]<<" ";
            }
        }
    }
    return 0;
}

5. count total duplicate pairs

#include <iostream>
using namespace std;
int main() {
    int n,count=0;
    cin>>n;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    for(int i=0;i<n;i++){
        for(int j=i+1;j<n;j++){
            if(arr[i]==arr[j]){
                count++;
            }
        }
    }
    if(count>0){
        cout<<"total pairs = "<<count;
    }
    return 0;
}

6. Find the maximum element using nested loops
#include <iostream>
using namespace std;
int main() {
    int n;
    cin>>n;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    int max=arr[0];
    for(int i=0;i<n;i++){
        for(int j=i+1;j<n;j++){
            if(arr[j]>max){
                max=arr[j];
            }
        }
    }
    cout<<max;
    return 0;
}

7. #include <iostream>
using namespace std;
int main() {
    int n;
    cin>>n;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    int min=arr[0];
    for(int i=0;i<n;i++){
        for(int j=i+1;j<n;j++){
            if(arr[j]<min){
                min=arr[j];
            }
        }
    }
    cout<<min;
    return 0;
}

10. replace duplicates with -1
#include <iostream>
using namespace std;
int main() {
    int n;
    cin>>n;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    for(int i=0;i<n;i++){
        for(int j=i+1;j<n;j++){
            if(arr[i]==arr[j]){
                arr[j]=-1;
            }
        }
    }
    for(int i=0;i<n;i++){
        cout<<arr[i]<<" ";
    }
   
}


11. Print all pairs whose sum is equal to a given number
#include <iostream>
using namespace std;
int main() {
    int n,sum;
    cin>>n;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    cin>>sum;
    for(int i=0;i<n;i++){
        for(int j=i+1;j<n;j++){
            if(arr[i]+arr[j]==sum){
    cout<<"{"<<arr[i]<<","<<arr[j]<<"}";
            }
        }
    }
}

12. Count number of pairs with sum = K
#include <iostream>
using namespace std;
int main() {
    int n,sum,count=0;
    cin>>n;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    cin>>sum;
    for(int i=0;i<n;i++){
        for(int j=i+1;j<n;j++){
            if(arr[i]+arr[j]==sum){
                count++;
            }
        }
    }
    cout<<count;
}

13. Print pairs whose product is even
#include <iostream>
using namespace std;
int main() {
    int n;
    cin>>n;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    for(int i=0;i<n;i++){
        for(int j=i+1;j<n;j++){
            if((arr[i]*arr[j])%2==0){
                cout<<"{"<<arr[i]<<","<<arr[j]<<"}";
            }
        }
    }
    
}

14. Count pairs where both elements are odd
#include <iostream>
using namespace std;
int main() {
    int n,count=0;
    cin>>n;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    for(int i=0;i<n;i++){
        for(int j=i+1;j<n;j++){
            if((arr[i]%2!=0) && (arr[j]%2!=0)){
                count++;
            }
        }
    }
    cout<<count;
    
}

15. Print pairs where first element is greater than second
#include <iostream>
using namespace std;
int main() {
    int n,count=0;
    cin>>n;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    for(int i=0;i<n;i++){
        for(int j=i+1;j<n;j++){
            if(arr[i]>arr[j]){
                 cout<<"{"<<arr[i]<<","<<arr[j]<<"}";
            }
        }
    }
}

16. Find pair with maximum sum
#include <iostream>
using namespace std;
int main() {
    int n,sum=0;
    cin>>n;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    int max1=arr[0];
    int max2=arr[1];
    for(int i=0;i<n;i++){
        for(int j=i+1;j<n;j++){
            if((arr[i]>max1) && (arr[j]>max2)){
                max1=arr[i];
                max2=arr[j];
            }
        }
    }
    cout<<"{"<<max1<<","<<max2<<"}";
}
