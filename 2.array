2. Count how many elements are equal to each other

#include <iostream>
using namespace std;
int main() {
    int n,count=0;
    cin>>n;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    for(int i=0;i<n;i++){
        for(int j=i+1;j<n;j++){
            if(arr[i]==arr[j]){
                count++;
            }
        }
    }
    cout<<"equal pairs = "<<count;
    return 0;
}
